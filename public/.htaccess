# Wrapped in IfModule: if a module is off on the web space, the server still
# answers instead of failing with 500.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force https, so the browser never loads the page over a plain connection.
  # The certificate check of Let's Encrypt stays on http, otherwise a renewal
  # can fail while the old certificate is already out of date.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Angular routes live in the browser. Anything that is not a real file is
  # answered with index.html, so a shared recipe link opens the recipe.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # The build puts a hash in every file name, so those may be cached for a year.
  <FilesMatch "\.(js|css|woff2|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # The entry page must not be cached, otherwise a new version never arrives.
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
