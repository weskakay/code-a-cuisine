      "id": "91d65f02-66d8-4461-ba99-445617194140",
      "name": "Recipe shape",
      "notesInFlow": true,
      "notes": "Forces the answer into the agreed fields, so the app always gets the same structure.\n"
    },
    {
      "parameters": {
        "jsCode": "// The model is asked politely, so the answer still has to be checked.\nconst answer = $json.output ?? $json;\nconst recipes = answer.recipes ?? [];\nconst wanted = $('Read visitor address').item.json.request.ingredients;\nconst problems = [];\n\nif (recipes.length !== 3) {\n  problems.push(`Expected three recipes, got ${recipes.length}.`);\n}\n\nfor (const recipe of recipes) {\n  const names = (recipe.yourIngredients ?? []).map((item) => item.name.toLowerCase());\n  const used = wanted.filter((item) => names.includes(item.name.toLowerCase())).length;\n  if (used / wanted.length < 0.7) {\n    problems.push(`\"${recipe.title}\" uses too few of the ingredients.`);\n  }\n  if ((recipe.extraIngredients ?? []).length > 3) {\n    problems.push(`\"${recipe.title}\" asks for more than three extra ingredients.`);\n  }\n}\n\nif (problems.length > 0) {\n  return [{ json: { rulesOk: false, error: problems[0] } }];\n}\n\nreturn [{ json: { rulesOk: true, recipes } }];\n"
      },
