      "name": "Respond to Webhook",
      "notesInFlow": true,
      "notes": "Answers the app with the result.\n"
    },
    {
      "parameters": {
        "jsCode": "const request = $json.body;\nconst errors = [];\n\nconst cuisines = ['german', 'italian', 'japanese', 'indian', 'gourmet', 'fusion'];\nconst diets = ['vegetarian', 'vegan', 'keto', 'none'];\nconst times = ['quick', 'medium', 'complex'];\n\nconst list = request.ingredients;\nif (!Array.isArray(list) || list.length === 0) {\n  errors.push('Add at least one ingredient.');\n} else {\n  for (const item of list) {\n    if (!item.name || !(item.amount > 0)) {\n      errors.push('Every ingredient needs a name and an amount.');\n      break;\n    }\n  }\n}\n\nif (!Number.isInteger(request.portions) || request.portions < 1 || request.portions > 12) {\n  errors.push('Portions must be between 1 and 12.');\n}\n\nif (!Number.isInteger(request.helpers) || request.helpers < 1 || request.helpers > 3) {\n  errors.push('Cooks must be between 1 and 3.');\n}\n\nif (!times.includes(request.cookingTime)) {\n  errors.push('Unknown cooking time.');\n}\n\nif (!cuisines.includes(request.cuisine)) {\n  errors.push('Unknown cuisine.');\n}\n\nif (!diets.includes(request.diet)) {\n  errors.push('Unknown diet.');\n}\n\nif (errors.length > 0) {\n  return [{ json: { valid: false, error: errors[0] } }];\n}\n\nreturn [{ json: { valid: true, request } }];\n"
      },
