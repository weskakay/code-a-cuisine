    {
      "parameters": {
        "jsCode": "// Only the entry our own proxy appends can be trusted, so read from the right.\n// Anything a caller puts in front of it is ignored.\nconst headers = $('Webhook').item.json.headers ?? {};\nconst chain = (headers['x-forwarded-for'] ?? '').split(',').map((part) => part.trim()).filter(Boolean);\nconst ip = chain.length ? chain[chain.length - 1] : (headers['x-real-ip'] ?? '127.0.0.1');\n\nreturn [{ json: { ip, request: $json.request } }];\n"
      },
