    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"recipes\": {\n      \"type\": \"array\",\n      \"minItems\": 3,\n      \"maxItems\": 3,\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"cookingMinutes\": {\n            \"type\": \"number\"\n          },\n          \"yourIngredients\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"name\": {\n                  \"type\": \"string\"\n                },\n                \"amount\": {\n                  \"type\": \"number\"\n                },\n                \"unit\": {\n                  \"type\": \"string\",\n                  \"enum\": [\n                    \"g\",\n                    \"ml\",\n                    \"piece\"\n                  ]\n                }\n              },\n              \"required\": [\n                \"name\",\n                \"amount\",\n                \"unit\"\n              ]\n            }\n          },\n          \"extraIngredients\": {\n            \"type\": \"array\",\n            \"maxItems\": 3,\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"name\": {\n                  \"type\": \"string\"\n                },\n                \"amount\": {\n                  \"type\": \"number\"\n                },\n                \"unit\": {\n                  \"type\": \"string\",\n                  \"enum\": [\n                    \"g\",\n                    \"ml\",\n                    \"piece\"\n                  ]\n                }\n              },\n              \"required\": [\n                \"name\",\n                \"amount\",\n                \"unit\"\n              ]\n            }\n          },\n          \"steps\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"position\": {\n                  \"type\": \"number\"\n                },\n                \"title\": {\n                  \"type\": \"string\"\n                },\n                \"text\": {\n                  \"type\": \"string\"\n                },\n                \"helper\": {\n                  \"type\": \"number\"\n                },\n                \"parallel\": {\n                  \"type\": \"boolean\"\n                },\n                \"durationMinutes\": {\n                  \"type\": \"number\"\n                },\n                \"waitMinutes\": {\n                  \"type\": \"number\"\n                }\n              },\n              \"required\": [\n                \"position\",\n                \"title\",\n                \"text\",\n                \"helper\",\n                \"parallel\",\n                \"durationMinutes\",\n                \"waitMinutes\"\n              ]\n            }\n          },\n          \"nutritionPerPortion\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"energyKcal\": {\n                \"type\": \"number\"\n              },\n              \"proteinG\": {\n                \"type\": \"number\"\n              },\n              \"carbsG\": {\n                \"type\": \"number\"\n              },\n              \"fatG\": {\n                \"type\": \"number\"\n              }\n            },\n            \"required\": [\n              \"energyKcal\",\n              \"proteinG\",\n              \"carbsG\",\n              \"fatG\"\n            ]\n          },\n          \"nutritionTotal\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"energyKcal\": {\n                \"type\": \"number\"\n              },\n              \"proteinG\": {\n                \"type\": \"number\"\n              },\n              \"carbsG\": {\n                \"type\": \"number\"\n              },\n              \"fatG\": {\n                \"type\": \"number\"\n              }\n            },\n            \"required\": [\n              \"energyKcal\",\n              \"proteinG\",\n              \"carbsG\",\n              \"fatG\"\n            ]\n          }\n        },\n        \"required\": [\n          \"title\",\n          \"cookingMinutes\",\n          \"yourIngredients\",\n          \"extraIngredients\",\n          \"steps\",\n          \"nutritionPerPortion\",\n          \"nutritionTotal\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"recipes\"\n  ]\n}"
