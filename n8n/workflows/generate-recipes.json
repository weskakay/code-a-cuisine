    {
      "parameters": {
        "jsCode": "// Turns the request into one clear order for the model.\nconst request = $('Read visitor address').item.json.request;\nconst list = request.ingredients\n  .map((item) => `${item.amount} ${item.unit} ${item.name}`)\n  .join(', ');\n\nconst prompt = [\n  'You are a cooking assistant. Create exactly three different recipes.',\n  `Ingredients at home: ${list}.`,\n  `Portions: ${request.portions}. Cooks in the kitchen: ${request.helpers}.`,\n  `Cooking style: ${request.cuisine}. Diet: ${request.diet}.`,\n  `Time frame: ${request.cookingTime} (quick is up to 20 minutes, medium 20 to 45, complex over 45).`,\n  'Every recipe uses at least 70 percent of the ingredients above.',\n  'Every recipe may add at most three basic extra ingredients.',\n  'The three recipes differ in preparation or taste.',\n  'Scale all amounts to the number of portions.',\n  'Steps are chronological. Mark steps that run in parallel and give each step a cook.',\n  'Use waiting times, for example time in the oven, for other steps.',\n  'Give durations in minutes and nutrition per portion and for the whole recipe.',\n  'Write every title and every text in English, whatever the cooking style is.',\n].join(' ');\n\nreturn [{ json: { prompt } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
