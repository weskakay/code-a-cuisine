    {
      "parameters": {
        "jsCode": "// The database uses snake_case columns, the app uses camelCase.\nconst request = $('Read visitor address').item.json.request;\n\nconst rows = $json.recipes.map((recipe) => ({\n  title: recipe.title,\n  cuisine: request.cuisine,\n  diet: request.diet,\n  cooking_time: request.cookingTime,\n  cooking_minutes: recipe.cookingMinutes,\n  portions: request.portions,\n  helpers: request.helpers,\n  your_ingredients: recipe.yourIngredients,\n  extra_ingredients: recipe.extraIngredients,\n  steps: recipe.steps,\n  nutrition_per_portion: recipe.nutritionPerPortion,\n  nutrition_total: recipe.nutritionTotal,\n}));\n\nreturn [{ json: { rows } }];\n"
